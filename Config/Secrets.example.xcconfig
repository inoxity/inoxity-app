// Copy to Secrets.local.xcconfig. Use a brand-new Inoxity V2 project only.
INOXITY_CONTROL_SUPABASE_URL = https:/$()/REPLACE_ME.supabase.co
INOXITY_CONTROL_SUPABASE_ANON_KEY = REPLACE_ME_PUBLIC_ANON_KEY

// Optional — only needed for the "Contact Research Team" feature in
// Settings. The dashboard's deployed URL (e.g. https://inoxity-dashboard.vercel.app)
// and the same value set as CONTACT_SHARED_SECRET in the dashboard's Vercel
// env vars. Leave blank to leave the feature hidden.
INOXITY_CONTACT_ENDPOINT_URL = https:/$()/REPLACE_ME.vercel.app
INOXITY_CONTACT_SHARED_SECRET = REPLACE_ME_SHARED_SECRET
